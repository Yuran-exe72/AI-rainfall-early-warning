@{
    ViewData["Title"] = "Dados";
}

<div class="container mt-4">

    <h2 style="color:#0f766e;">Importação de Dados</h2>
    <p class="text-muted">Importe observações climáticas em formato CSV para as regiões de Mabote e Govuro.</p>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    <!-- Cartao: Importacao de CSV -->
    <div class="card shadow-sm mb-4" style="border-top:4px solid #0d9488;">
        <div class="card-body">
            <h5 class="card-title">Importar Ficheiro CSV</h5>
            <p class="card-text text-muted">
                Seleccione a região correspondente ao ficheiro e envie o CSV com as observações climáticas.
            </p>

            <form asp-controller="Data" asp-action="Import" method="post"
                  enctype="multipart/form-data" class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label">Região</label>
                    <select name="regionId" class="form-select" required>
                        <option value="1">Govuro</option>
                        <option value="2">Mabote</option>
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label">Ficheiro CSV</label>
                    <input type="file" name="file" class="form-control" accept=".csv" required />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn text-white w-100" style="background:#0d9488;">
                        Importar
                    </button>
                </div>
            </form>

            <div class="mt-3 text-muted small">
                Limite de tamanho: 5 MB · Extensão permitida: .csv
            </div>
        </div>
    </div>

    <!-- Cartao: formato esperado -->
    <div class="card shadow-sm" style="border-top:4px solid #0f766e;">
        <div class="card-body">
            <h5 class="card-title">Formato esperado do CSV</h5>
            <p class="card-text text-muted mb-2">
                O ficheiro deve conter as colunas de data, precipitação (mm), humidade do solo e temperatura (°C),
                conforme os ficheiros gerados para o projecto.
            </p>
            <pre class="bg-light p-3 rounded small mb-0">date,rainfall_mm,soil_moisture,temperature_c
2024-01-01,12.5,0.42,28.3
2024-01-02,0.0,0.40,29.1</pre>
        </div>
    </div>

</div>