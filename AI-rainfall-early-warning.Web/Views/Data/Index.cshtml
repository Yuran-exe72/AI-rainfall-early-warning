@model IEnumerable<AI_rainfall_early_warning.Domain.Entities.DataImport>
@{
    ViewData["Title"] = "Importações";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📊 Importações de Dados</h2>
    <a asp-action="Upload" class="btn btn-primary">⬆️ Novo Import</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Ficheiro</th>
            <th>Fonte</th>
            <th>Data</th>
            <th>Importadas</th>
            <th>Rejeitadas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FileName</td>
                <td><span class="badge bg-secondary">@item.Source</span></td>
                <td>@item.ImportedAt.ToString("g")</td>
                <td class="text-success fw-bold">@item.RowsImported</td>
                <td class="@(item.RowsRejected > 0 ? "text-danger fw-bold" : "")">@item.RowsRejected</td>
            </tr>
        }
    </tbody>
</table>