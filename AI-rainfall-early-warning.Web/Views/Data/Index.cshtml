@model IEnumerable<AI_rainfall_early_warning.Domain.Entities.DataImport>
@{
    ViewData["Title"] = "Importações";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">Importações de dados</h2>
        <p class="text-muted small mb-0">Histórico de ficheiros processados pelo pipeline</p>
    </div>
    <a asp-action="Upload" class="btn btn-brand">+ Novo import</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-soft">@ok</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.Count()</div>
            <div class="stat-label">Importações registadas</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.Sum(i => i.RowsImported).ToString("N0")</div>
            <div class="stat-label">Linhas importadas</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.Sum(i => i.RowsRejected)</div>
            <div class="stat-label">Linhas rejeitadas</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover data-table mb-0">
            <thead>
                <tr>
                    <th>Ficheiro</th>
                    <th>Fonte</th>
                    <th>Data</th>
                    <th class="text-end">Importadas</th>
                    <th class="text-end">Rejeitadas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Source switch
                    {
                        "CHIRPS" => "badge-chirps",
                        "ERA5-Land" => "badge-era5",
                        _ => "badge-smap"
                    };
                    <tr>
                        <td class="fw-semibold">@item.FileName</td>
                        <td><span class="badge-source @badgeClass">@item.Source</span></td>
                        <td class="text-muted">@item.ImportedAt.ToString("g")</td>
                        <td class="text-end text-success fw-bold">@item.RowsImported.ToString("N0")</td>
                        <td class="text-end @(item.RowsRejected > 0 ? "text-danger fw-bold" : "text-muted")">@item.RowsRejected</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>