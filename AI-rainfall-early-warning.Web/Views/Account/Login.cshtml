@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center align-items-center login-page">
    <div class="col-md-4">
        <div class="card login-card">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="login-logo">💧</div>
                    <h4 class="mb-0 fw-bold">ClimaAlerta MZ</h4>
                    <p class="text-muted small mb-0">Sistema de Alerta Precoce — Inhambane</p>
                </div>
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">E-mail</label>
                        <input type="email" name="email" class="form-control form-control-lg" required autofocus />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Palavra-passe</label>
                        <input type="password" name="password" class="form-control form-control-lg" required />
                    </div>
                    <button type="submit" class="btn btn-brand btn-lg w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>