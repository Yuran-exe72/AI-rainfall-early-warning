@{
    ViewData["Title"] = "Previsão";
}

<h2 class="fw-bold mb-3">Previsão e alerta de seca</h2>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold">1. Treinar modelo</h5>
                <p class="text-muted">
                    Treina o modelo com o histórico climático (features com atrasos de 1, 3 e 7 dias,
                    humidade do solo e temperatura). Divisão temporal 80/20 — sem fuga de dados.
                </p>
                @if ((bool)ViewBag.ModelExists)
                {
                    <span class="badge-source badge-smap">Modelo treinado ✓</span>
                }
                else
                {
                    <span class="badge-source badge-era5">Modelo ainda não treinado</span>
                }
                <div class="mt-3">
                    <a asp-action="Train" class="btn btn-brand">Treinar modelo</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold">2. Ver previsão de 7 dias</h5>
                <p class="text-muted">
                    Previsão iterativa para os próximos 7 dias com classificação de risco:
                    Normal, Atenção, Alerta ou Emergência.
                </p>
                <div class="mt-3">
                    <a asp-action="Forecast" class="btn btn-outline-secondary">Ver previsão</a>
                </div>
            </div>
        </div>
    </div>
</div>