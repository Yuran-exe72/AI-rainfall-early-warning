@model AI_rainfall_early_warning.Web.Models.ForecastViewModel
@{
    ViewData["Title"] = "Previsão";
    bool isAdmin = User.IsInRole("Administrador");
}

<div class="container mt-4">

    <h2 style="color:#0f766e;">Previsão de Precipitação</h2>
    <p class="text-muted">Treino do modelo e previsão a 7 dias para Mabote e Govuro.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.TrainMessage))
    {
        <div class="alert alert-success">@Model.TrainMessage</div>
    }

    <!-- Cartao 1: Treino do modelo -->
    <div class="card shadow-sm mb-4" style="border-top:4px solid #0d9488;">
        <div class="card-body">
            <h5 class="card-title">Treino do Modelo</h5>
            <p class="card-text text-muted">
                Estado: @(Model.ModelExists ? "modelo treinado disponível" : "modelo ainda não treinado")
            </p>

            @if (Model.R2.HasValue && Model.Rmse.HasValue)
            {
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="p-3 rounded" style="background:#f0fdfa; border:1px solid #99f6e4;">
                            <small class="text-muted">R² (conjunto de teste)</small>
                            <div style="font-size:1.6rem; color:#0f766e;">@Model.R2.Value.ToString("0.000")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded" style="background:#f0fdfa; border:1px solid #99f6e4;">
                            <small class="text-muted">RMSE (mm)</small>
                            <div style="font-size:1.6rem; color:#0f766e;">@Model.Rmse.Value.ToString("0.00")</div>
                        </div>
                    </div>
                </div>
            }

            @if (isAdmin)
            {
                <form asp-action="Train" method="post">
                    <button type="submit" class="btn text-white" style="background:#0d9488;">
                        Treinar Modelo
                    </button>
                </form>
            }
            else
            {
                <span class="badge bg-secondary">Apenas administradores podem treinar o modelo</span>
            }
        </div>
    </div>

    <!-- Cartao 2: Previsao de 7 dias -->
    <div class="card shadow-sm mb-4" style="border-top:4px solid #0d9488;">
        <div class="card-body">
            <h5 class="card-title">Previsão a 7 Dias</h5>

            <form asp-action="Predict" method="post" class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Região</label>
                    <select name="regionId" class="form-select">
                        @foreach (var r in Model.Regions)
                        {
                            <option value="@r.Id" selected="@(Model.SelectedRegionId == r.Id)">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn text-white w-100" style="background:#0f766e;">
                        Prever
                    </button>
                </div>
            </form>

            @if (Model.Forecast != null && Model.Forecast.Count > 0)
            {
                <h6 class="mt-3">Previsão para @Model.SelectedRegionName — próximos 7 dias</h6>
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Precipitação prevista (mm)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (dynamic f in Model.Forecast)
                        {
                            <tr>
                                <td>@f.Date.ToString("dd/MM/yyyy")</td>
                                <td>@f.PredictedRainfallMm.ToString("0.0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>